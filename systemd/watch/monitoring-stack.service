[Unit]
Description=Uptime Kuma monitoring stack
After=docker.service network-online.target tailscaled.service
Requires=docker.service
Wants=network-online.target
ConditionPathExists=/srv/docker/watch/monitoring/docker-compose.yml

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/docker/watch/monitoring
ExecStartPre=/usr/bin/docker compose pull --quiet
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300
User=mez
Group=mez

[Install]
WantedBy=multi-user.target
