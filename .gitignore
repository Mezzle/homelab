# Secrets
**/.env
**/node_modules/

# Pulumi local state and generated artifacts
infra/**/.pulumi/
infra/**/dist/

# Application data
**/appdata/

# Tailscale node state (contains private keys)
**/config/tailscale/*/state/

# SSH keys
**/config/seedbox/id_rsa
**/config/seedbox/id_ed25519

# Gluetun state
**/config/gluetun/

# Mosquitto passwords and upstream bridge credentials
**/config/mosquitto/password_file
**/config/mosquitto/conf.d/glowmqtt.conf

# Ignition files (generated from .bu)
coreos/*.ign

# Python virtualenvs and bytecode
**/.venv/
**/__pycache__/
*.py[cod]

# OS junk
.DS_Store
Thumbs.db
fedora-coreos-43.20260301.3.1-oraclecloud.aarch64.qcow2

# Uptime Kuma push tokens (per-host, deployed out-of-band)
heartbeat-tokens.env
**/heartbeat-tokens.env

# Recyclarr runtime state (generated on each sync)
**/config/recyclarr/logs/
**/config/recyclarr/resources/
**/config/recyclarr/state/
**/config/recyclarr/settings.yml

# Homepage runtime (generated config, user customizations stay local)
**/config/homepage/logs/
**/config/homepage/custom.css
**/config/homepage/custom.js
**/config/homepage/kubernetes.yaml
**/config/homepage/proxmox.yaml
