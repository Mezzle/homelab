###############################################################################
# charm.bu — Fedora CoreOS Butane config for the home server (Mac Mini)
#
# Hardware: Intel i5-4260U (2c/4t), 4GB RAM, 480GB SSD, Intel HD 5000
#
# Transpile with ./transpile.sh charm.bu, then:
#   coreos-installer install /dev/sda --ignition-file charm.ign
#
# After first boot:
#   1. Wait for uCore auto-rebase (~2 reboots, ~5-10 min total)
#   2. SSH in:  ssh mez@charm  (via Tailscale)
#   3. Run the bootstrap script:
#        curl -sL https://raw.githubusercontent.com/Mezzle/homelab/main/scripts/bootstrap.sh \
#          | bash -s -- docker/charm
#
# After that, push to git — gitops-sync pulls every 5 minutes.
#
# uCore image: ghcr.io/ublue-os/ucore-minimal:stable
#   Docker + compose, Tailscale, Cockpit.
#
# Anything that gitops-sync should be able to update later lives in
# coreos/os-configs/ and is referenced here with `local:` / `contents_local:`.
###############################################################################
variant: fcos
version: "1.7.0"

passwd:
  groups:
    - name: docker
  users:
    - name: mez
      ssh_authorized_keys:
        - ssh-ed25519 CHANGEME mez@laptop
      groups:
        - docker
        - wheel
      shell: /bin/bash
    - name: homelab-operator
      shell: /bin/bash

storage:
  directories:
    # Repo root — /srv is a symlink to /var/srv on FCOS.
    # Don't create subdirectories here; git clone provides them.
    - path: /var/srv
      mode: 0755
      user: { name: mez }
      group: { name: mez }

    - path: /etc/ucore-autorebase
      mode: 0754

  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: charm

    # Zincati — reboot for OS updates only on Sundays 04:00-05:00 UTC.
    - path: /etc/zincati/config.d/55-updates-strategy.toml
      mode: 0644
      contents:
        inline: |
          [updates]
          strategy = "periodic"
          [[updates.periodic.window]]
          days = [ "Sun" ]
          start_time = "04:00"
          length_minutes = 60

    # Passwordless sudo for wheel (gitops-sync installs OS configs with sudo)
    - path: /etc/sudoers.d/wheel-nopasswd
      mode: 0440
      contents:
        inline: |
          %wheel ALL=(ALL) NOPASSWD: ALL

    # Tailscale auth key — consumed and deleted by tailscale-auth.service.
    # Replace with a reusable + ephemeral key from:
    #   https://login.tailscale.com/admin/settings/keys
    - path: /etc/tailscale-authkey
      mode: 0600
      contents:
        inline: |
          tskey-auth-CHANGEME

    ##################################################################
    # Files shared with gitops-sync (coreos/os-configs/manifest.conf).
    # Same source on first boot and on every later change.
    ##################################################################
    - path: /etc/sysctl.d/90-arr-tuning.conf
      mode: 0644
      contents:
        local: os-configs/sysctl-90-arr-tuning.conf

    - path: /etc/docker/daemon.json
      mode: 0644
      contents:
        local: os-configs/docker-daemon.json

    - path: /etc/ssh/sshd_config.d/50-hardening.conf
      mode: 0600
      contents:
        local: os-configs/sshd-50-hardening.conf

    - path: /etc/profile.d/motd.sh
      mode: 0755
      contents:
        local: os-configs/charm/motd.sh

    - path: /etc/modules-load.d/home.conf
      mode: 0644
      contents:
        inline: |
          tun

systemd:
  units:
    - name: docker.service
      enabled: true

    ##################################################################
    # uCore auto-rebase — switch from stock CoreOS to uCore
    #
    # Two-stage process on first boot:
    #   1. Rebase to unsigned uCore image → reboot
    #   2. Rebase to signed uCore image → reboot
    ##################################################################
    - name: ucore-unsigned-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=uCore autorebase to unsigned OCI and reboot
        ConditionPathExists=!/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:ghcr.io/ublue-os/ucore-minimal:stable
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/unverified
        ExecStart=/usr/bin/systemctl disable ucore-unsigned-autorebase.service
        ExecStart=/usr/bin/systemctl reboot

        [Install]
        WantedBy=multi-user.target

    - name: ucore-signed-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=uCore autorebase to signed OCI and reboot
        ConditionPathExists=/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-image-signed:docker://ghcr.io/ublue-os/ucore-minimal:stable
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/signed
        ExecStart=/usr/bin/systemctl disable ucore-signed-autorebase.service
        ExecStart=/usr/bin/systemctl reboot

        [Install]
        WantedBy=multi-user.target

    ##################################################################
    # Tailscale — host-level tailnet connectivity (SSH, DNS, identity).
    # Per-service HTTPS is handled by DockTail in each host's infra stack.
    ##################################################################
    - name: tailscaled.service
      enabled: true

    - name: tailscale-auth.service
      enabled: true
      contents: |
        [Unit]
        Description=Authenticate Tailscale on first boot
        After=tailscaled.service network-online.target
        Requires=tailscaled.service
        ConditionPathExists=/etc/tailscale-authkey
        ConditionPathExists=!/var/lib/tailscale-auth-done

        [Service]
        Type=oneshot
        ExecStart=/bin/bash -c '\
          tailscale up \
            --authkey=$(cat /etc/tailscale-authkey | tr -d "[:space:]") \
            --hostname=charm \
            --ssh && \
          touch /var/lib/tailscale-auth-done && \
          rm -f /etc/tailscale-authkey'
        TimeoutStartSec=60

        [Install]
        WantedBy=multi-user.target

    # Cockpit web UI, socket-activated: https://charm:9090
    - name: cockpit.socket
      enabled: true

    ##################################################################
    # Docker Compose stacks — one stack@ instance per directory under
    # /srv/docker/charm/.
    ##################################################################
    - name: stack@.service
      contents_local: os-configs/common/stack@.service

    - name: stack@home.service
      enabled: true

    - name: stack@monitoring.service
      enabled: true

    - name: stack@infra.service
      enabled: true
      dropins:
        - name: order.conf
          contents_local: os-configs/charm/stack@infra.service.d/order.conf

    ##################################################################
    # Shared units from coreos/os-configs/common/. gitops-sync keeps
    # them current after install; see manifest.conf.
    ##################################################################
    - name: gitops-sync.service
      contents_local: os-configs/common/gitops-sync.service
    - name: gitops-sync.timer
      enabled: true
      contents_local: os-configs/common/gitops-sync.timer

    - name: docker-prune.service
      contents_local: os-configs/common/docker-prune.service
    - name: docker-prune.timer
      enabled: true
      contents_local: os-configs/common/docker-prune.timer

    - name: container-heartbeat.service
      contents_local: os-configs/common/container-heartbeat.service
    - name: container-heartbeat.timer
      enabled: true
      contents_local: os-configs/common/container-heartbeat.timer

    - name: backup.service
      contents_local: os-configs/common/backup.service
    - name: backup.timer
      enabled: true
      contents_local: os-configs/common/backup.timer
