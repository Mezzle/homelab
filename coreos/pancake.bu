###############################################################################
# pancake.bu — Fedora CoreOS Butane config for the media server (laptop)
#
# Hardware: Intel i7-5700HQ (4c/8t), 16GB RAM, 240GB SSD, 1TB HDD,
#           NVIDIA GTX 970M
#
# Transpile with ./transpile.sh pancake.bu (pulls secrets from 1Password and
# resolves the os-configs/ references), then either:
#   - coreos-installer install /dev/sda --ignition-file pancake.ign
#   - or serve pancake.ign over HTTP for PXE/iPXE boot
#
# After first boot:
#   1. SSH in:  ssh mez@<ip>
#   2. Confirm the HDD by-id path in var-mnt-storage.mount matches
#      ls -l /dev/disk/by-id/ and that it is formatted (mkfs.ext4).
#   3. Create /etc/nas-arr.credentials and /etc/nas-photos.credentials
#      (root:root 0600, username=/password= lines).
#   4. Run the bootstrap script:
#        curl -sL https://raw.githubusercontent.com/Mezzle/homelab/main/scripts/bootstrap.sh \
#          | bash -s -- docker/pancake
#
# After that, push to git — gitops-sync pulls every 5 minutes.
#
# First boot rebases stock Fedora CoreOS to uCore (two automatic reboots).
# uCore image: ghcr.io/ublue-os/ucore-minimal:stable-nvidia-lts
#   Docker + compose, NVIDIA open drivers (LTS, Maxwell support),
#   nvidia-container-toolkit (CDI), Tailscale.
#
# Anything that gitops-sync should be able to update later lives in
# coreos/os-configs/ and is referenced here with `local:` / `contents_local:`.
###############################################################################
variant: fcos
version: "1.7.0"

passwd:
  groups:
    - name: docker
  users:
    - name: mez
      ssh_authorized_keys:
        - ssh-ed25519 CHANGEME mez@laptop
      groups:
        - docker
        - wheel
      shell: /bin/bash
    - name: homelab-operator
      shell: /bin/bash

storage:
  directories:
    # Repo root — /srv is a symlink to /var/srv on FCOS.
    # Don't create subdirectories here; git clone provides them.
    - path: /var/srv
      mode: 0755
      user: { name: mez }
      group: { name: mez }

    - path: /etc/ucore-autorebase
      mode: 0754

    # HDD mount point and the directories containers expect on it
    - path: /var/mnt/storage
      mode: 0755
      user: { name: mez }
      group: { name: mez }
    - path: /var/mnt/storage/media
      mode: 0755
      user: { name: mez }
      group: { name: mez }
    - path: /var/mnt/storage/photos
      mode: 0755
      user: { name: mez }
      group: { name: mez }
    - path: /var/mnt/storage/cache
      mode: 0755
      user: { name: mez }
      group: { name: mez }
    # rclone's seedbox VFS cache — on the HDD, not the container overlay
    - path: /var/mnt/storage/cache/rclone
      mode: 0755
      user: { name: mez }
      group: { name: mez }

  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: pancake

    # Zincati — reboot for OS updates only on Sundays 04:00-05:00 UTC.
    - path: /etc/zincati/config.d/55-updates-strategy.toml
      mode: 0644
      contents:
        local: os-configs/common/zincati-updates.toml

    # Passwordless sudo for wheel (gitops-sync installs OS configs with sudo)
    - path: /etc/sudoers.d/wheel-nopasswd
      mode: 0440
      contents:
        inline: |
          %wheel ALL=(ALL) NOPASSWD: ALL

    # Tailscale auth key — consumed and deleted by tailscale-auth.service.
    # Replace with a reusable + ephemeral key from:
    #   https://login.tailscale.com/admin/settings/keys
    - path: /etc/tailscale-authkey
      mode: 0600
      contents:
        inline: |
          tskey-auth-CHANGEME

    ##################################################################
    # Files shared with gitops-sync (coreos/os-configs/manifest.conf).
    # Same source on first boot and on every later change.
    ##################################################################
    - path: /etc/sysctl.d/90-base.conf
      mode: 0644
      contents:
        local: os-configs/sysctl-90-base.conf

    - path: /etc/sysctl.d/90-arr-tuning.conf
      mode: 0644
      contents:
        local: os-configs/pancake/sysctl-90-arr-tuning.conf

    - path: /etc/docker/daemon.json
      mode: 0644
      contents:
        local: os-configs/docker-daemon.json

    - path: /etc/ssh/sshd_config.d/50-hardening.conf
      mode: 0600
      contents:
        local: os-configs/sshd-50-hardening.conf

    - path: /etc/profile.d/motd.sh
      mode: 0755
      contents:
        local: os-configs/pancake/motd.sh

    - path: /etc/modules-load.d/pancake.conf
      mode: 0644
      contents:
        local: os-configs/pancake/modules-load.conf

    - path: /usr/local/sbin/nas-mount-check.sh
      mode: 0755
      contents:
        local: os-configs/pancake/nas-mount-check.sh

    - path: /usr/local/sbin/speedtest-usb-routing.sh
      mode: 0755
      contents:
        local: os-configs/pancake/speedtest-usb-routing.sh

systemd:
  units:
    - name: docker.service
      enabled: true

    ##################################################################
    # uCore auto-rebase — switch from stock CoreOS to uCore
    #
    # Two-stage process on first boot:
    #   1. Rebase to unsigned uCore image → reboot
    #   2. Rebase to signed uCore image → reboot
    ##################################################################
    - name: ucore-unsigned-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=uCore autorebase to unsigned OCI and reboot
        ConditionPathExists=!/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:ghcr.io/ublue-os/ucore-minimal:stable-nvidia-lts
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/unverified
        ExecStart=/usr/bin/systemctl disable ucore-unsigned-autorebase.service
        ExecStart=/usr/bin/systemctl reboot

        [Install]
        WantedBy=multi-user.target

    - name: ucore-signed-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=uCore autorebase to signed OCI and reboot
        ConditionPathExists=/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-image-signed:docker://ghcr.io/ublue-os/ucore-minimal:stable-nvidia-lts
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/signed
        ExecStart=/usr/bin/systemctl disable ucore-signed-autorebase.service
        ExecStart=/usr/bin/systemctl reboot

        [Install]
        WantedBy=multi-user.target

    ##################################################################
    # Tailscale — host-level tailnet connectivity (SSH, DNS, identity).
    # Per-service HTTPS is handled by DockTail in each host's infra stack.
    ##################################################################
    - name: tailscaled.service
      enabled: true

    - name: tailscale-auth.service
      enabled: true
      contents: |
        [Unit]
        Description=Authenticate Tailscale on first boot
        After=tailscaled.service network-online.target
        Requires=tailscaled.service
        ConditionPathExists=/etc/tailscale-authkey
        ConditionPathExists=!/var/lib/tailscale-auth-done

        [Service]
        Type=oneshot
        ExecStart=/bin/bash -c '\
          tailscale up \
            --authkey=$(cat /etc/tailscale-authkey | tr -d "[:space:]") \
            --hostname=pancake \
            --ssh && \
          touch /var/lib/tailscale-auth-done && \
          rm -f /etc/tailscale-authkey'
        TimeoutStartSec=60

        [Install]
        WantedBy=multi-user.target

    ##################################################################
    # HDD storage mount — /var/mnt/storage
    # The by-id path is substituted by transpile.sh from 1Password.
    ##################################################################
    - name: var-mnt-storage.mount
      enabled: true
      contents: |
        [Unit]
        Description=Mount 1TB HDD at /var/mnt/storage
        Before=local-fs.target

        [Mount]
        What=/dev/disk/by-id/CHANGEME-1TB-HDD-ID
        Where=/var/mnt/storage
        Type=ext4
        Options=defaults,noatime

        [Install]
        WantedBy=local-fs.target

    - name: var-mnt-storage-permissions.service
      enabled: true
      contents: |
        [Unit]
        Description=Set ownership on /var/mnt/storage after mount
        After=var-mnt-storage.mount
        Requires=var-mnt-storage.mount

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/chown -R mez:mez /var/mnt/storage

        [Install]
        WantedBy=local-fs.target

    ##################################################################
    # NAS CIFS mounts — /var/mnt/nas/{media,backup,photos}
    #
    # Host-level systemd automounts, bind-mounted into containers. The
    # docker local CIFS volume driver loses its mount under container
    # churn and never remounts; automounts re-establish on next access
    # and a NAS outage can't block boot.
    #
    # Credentials are NOT in git. Create on the host (root:root 0600),
    # each with username=/password= lines:
    #   /etc/nas-arr.credentials      # NAS user for media + backup
    #   /etc/nas-photos.credentials   # NAS user for photos
    ##################################################################
    - name: var-mnt-nas-media.mount
      contents: |
        [Unit]
        Description=NAS media share (CIFS)
        After=network-online.target
        Wants=network-online.target

        [Mount]
        What=//192.168.5.103/Multimedia
        Where=/var/mnt/nas/media
        Type=cifs
        Options=credentials=/etc/nas-arr.credentials,uid=1001,gid=1001,iocharset=utf8,vers=3.0,file_mode=0777,dir_mode=0777,noperm,context=system_u:object_r:container_file_t:s0,_netdev

    - name: var-mnt-nas-media.automount
      enabled: true
      contents: |
        [Unit]
        Description=Automount NAS media share

        [Automount]
        Where=/var/mnt/nas/media

        [Install]
        WantedBy=remote-fs.target

    - name: var-mnt-nas-backup.mount
      contents: |
        [Unit]
        Description=NAS backup share (CIFS)
        After=network-online.target
        Wants=network-online.target

        [Mount]
        What=//192.168.5.103/backup
        Where=/var/mnt/nas/backup
        Type=cifs
        Options=credentials=/etc/nas-arr.credentials,uid=1001,gid=1001,iocharset=utf8,vers=3.0,file_mode=0777,dir_mode=0777,noperm,context=system_u:object_r:container_file_t:s0,_netdev

    - name: var-mnt-nas-backup.automount
      enabled: true
      contents: |
        [Unit]
        Description=Automount NAS backup share

        [Automount]
        Where=/var/mnt/nas/backup

        [Install]
        WantedBy=remote-fs.target

    - name: var-mnt-nas-photos.mount
      contents: |
        [Unit]
        Description=NAS photos share (CIFS)
        After=network-online.target
        Wants=network-online.target

        [Mount]
        What=//192.168.5.103/photos
        Where=/var/mnt/nas/photos
        Type=cifs
        Options=credentials=/etc/nas-photos.credentials,uid=1000,gid=1000,iocharset=utf8,vers=3.0,file_mode=0755,dir_mode=0755,soft,context=system_u:object_r:container_file_t:s0,_netdev

    - name: var-mnt-nas-photos.automount
      enabled: true
      contents: |
        [Unit]
        Description=Automount NAS photos share

        [Automount]
        Where=/var/mnt/nas/photos

        [Install]
        WantedBy=remote-fs.target

    ##################################################################
    # Docker Compose stacks — one stack@ instance per directory under
    # /srv/docker/pancake/. Mount and ordering dependencies are drop-ins
    # in os-configs/pancake/stack@<name>.service.d/.
    ##################################################################
    - name: stack@.service
      contents_local: os-configs/common/stack@.service

    - name: stack@arr.service
      enabled: true
      dropins:
        - name: mounts.conf
          contents_local: os-configs/pancake/stack@arr.service.d/mounts.conf

    - name: stack@immich.service
      enabled: true
      dropins:
        - name: mounts.conf
          contents_local: os-configs/pancake/stack@immich.service.d/mounts.conf

    - name: stack@music.service
      enabled: true
      dropins:
        - name: order.conf
          contents_local: os-configs/pancake/stack@music.service.d/order.conf

    - name: stack@speedtest.service
      enabled: true

    - name: stack@infra.service
      enabled: true
      dropins:
        - name: order.conf
          contents_local: os-configs/pancake/stack@infra.service.d/order.conf

    ##################################################################
    # pancake-only timers (scripts + units live in os-configs/pancake/)
    ##################################################################
    - name: nas-mount-check.service
      contents_local: os-configs/pancake/nas-mount-check.service
    - name: nas-mount-check.timer
      enabled: true
      contents_local: os-configs/pancake/nas-mount-check.timer

    - name: speedtest-usb-routing.service
      enabled: true
      contents_local: os-configs/pancake/speedtest-usb-routing.service
    - name: speedtest-usb-routing.timer
      enabled: true
      contents_local: os-configs/pancake/speedtest-usb-routing.timer

    ##################################################################
    # Shared units from coreos/os-configs/common/. gitops-sync keeps
    # them current after install; see manifest.conf.
    ##################################################################
    - name: gitops-sync.service
      contents_local: os-configs/common/gitops-sync.service
    - name: gitops-sync.timer
      enabled: true
      contents_local: os-configs/common/gitops-sync.timer

    - name: docker-prune.service
      contents_local: os-configs/common/docker-prune.service
    - name: docker-prune.timer
      enabled: true
      contents_local: os-configs/common/docker-prune.timer

    - name: container-heartbeat.service
      contents_local: os-configs/common/container-heartbeat.service
    - name: container-heartbeat.timer
      enabled: true
      contents_local: os-configs/common/container-heartbeat.timer

    - name: backup.service
      contents_local: os-configs/common/backup.service
    - name: backup.timer
      enabled: true
      contents_local: os-configs/common/backup.timer
