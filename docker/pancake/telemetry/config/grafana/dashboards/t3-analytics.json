{
  "uid": "t3-analytics",
  "title": "T3 Code analytics",
  "description": "Starter dashboard from T3 Code's PostHog-format events, stored in Loki as {service_name=\"t3-analytics\"}.",
  "tags": [
    "t3code",
    "starter"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Turns",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Turns completed",
      "id": 2,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=\"t3-analytics\", event=\"provider.turn.completed\"} [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Turns by model",
      "id": 3,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 9,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "displayMode": "basic"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (model) (count_over_time({service_name=\"t3-analytics\", event=\"provider.turn.completed\"} | json model=\"model\" [$__range]))",
          "legendFormat": "{{model}}",
          "queryType": "instant"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Turns by provider and status",
      "id": 4,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 15,
        "y": 1,
        "w": 9,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "displayMode": "basic"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (provider, terminalStatus) (count_over_time({service_name=\"t3-analytics\", event=\"provider.turn.completed\"} | json provider=\"provider\", terminalStatus=\"terminalStatus\" [$__range]))",
          "legendFormat": "{{provider}} {{terminalStatus}}",
          "queryType": "instant"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Turns completed, by model",
      "id": 5,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (model) (count_over_time({service_name=\"t3-analytics\", event=\"provider.turn.completed\"} | json model=\"model\" [$__auto]))",
          "legendFormat": "{{model}}",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Turn duration p50 / p95, by model",
      "id": 6,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.5, {service_name=\"t3-analytics\", event=\"provider.turn.completed\"} | json model=\"model\", v=\"durationMs\" | unwrap v | __error__=\"\" [$__auto]) by (model)",
          "legendFormat": "p50 {{model}}",
          "queryType": "range"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {service_name=\"t3-analytics\", event=\"provider.turn.completed\"} | json model=\"model\", v=\"durationMs\" | unwrap v | __error__=\"\" [$__auto]) by (model)",
          "legendFormat": "p95 {{model}}",
          "queryType": "range"
        }
      ],
      "description": "durationMs on provider.turn.completed: provider turn start to completion."
    },
    {
      "type": "row",
      "title": "Tokens",
      "id": 7,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Tokens per interval, by type",
      "id": 8,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({service_name=\"t3-analytics\", event=\"provider.turn.completed\"} | json v=\"inputTokens\" | unwrap v | __error__=\"\" [$__auto]))",
          "legendFormat": "input",
          "queryType": "range"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({service_name=\"t3-analytics\", event=\"provider.turn.completed\"} | json v=\"cachedInputTokens\" | unwrap v | __error__=\"\" [$__auto]))",
          "legendFormat": "cached input",
          "queryType": "range"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({service_name=\"t3-analytics\", event=\"provider.turn.completed\"} | json v=\"cacheCreationTokens\" | unwrap v | __error__=\"\" [$__auto]))",
          "legendFormat": "cache creation",
          "queryType": "range"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({service_name=\"t3-analytics\", event=\"provider.turn.completed\"} | json v=\"outputTokens\" | unwrap v | __error__=\"\" [$__auto]))",
          "legendFormat": "output",
          "queryType": "range"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({service_name=\"t3-analytics\", event=\"provider.turn.completed\"} | json v=\"reasoningTokens\" | unwrap v | __error__=\"\" [$__auto]))",
          "legendFormat": "reasoning",
          "queryType": "range"
        }
      ],
      "description": "From provider.turn.completed. Turns whose usageStatus is unavailable carry no token fields."
    },
    {
      "type": "bargauge",
      "title": "Tokens in time range, by model",
      "id": 9,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "displayMode": "basic"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (model) (sum_over_time({service_name=\"t3-analytics\", event=\"provider.turn.completed\"} | json model=\"model\", v=\"inputTokens\" | unwrap v | __error__=\"\" [$__range]))",
          "legendFormat": "input {{model}}",
          "queryType": "instant"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (model) (sum_over_time({service_name=\"t3-analytics\", event=\"provider.turn.completed\"} | json model=\"model\", v=\"outputTokens\" | unwrap v | __error__=\"\" [$__range]))",
          "legendFormat": "output {{model}}",
          "queryType": "instant"
        }
      ]
    },
    {
      "type": "row",
      "title": "Events",
      "id": 10,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Analytics events, by name",
      "id": 11,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (event) (count_over_time({service_name=\"t3-analytics\"} [$__auto]))",
          "legendFormat": "{{event}}",
          "queryType": "range"
        }
      ]
    }
  ]
}
