# Synced from the 1Password item docker.pancake.telemetry in the Homelab vault.
#
# Tailscale auth for the ts-telemetry node, which joins as tag:telemetry. Either:
#   - a non-ephemeral pre-auth key tagged tag:telemetry (tskey-auth-...), or
#   - an OAuth client secret with auth_keys write scope that owns tag:telemetry,
#     suffixed with ?ephemeral=false (tskey-client-...?ephemeral=false)
# "requested tags [tag:telemetry] are invalid or not permitted" means the
# tailnet policy has no tagOwners entry for tag:telemetry, or the key lacks it.
# Only used on first join; the node identity then lives in the ts-state volume.
TS_AUTHKEY=
# Grafana admin password. No `$`: compose interpolates it.
GF_SECURITY_ADMIN_PASSWORD=
