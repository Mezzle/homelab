# Hermes dashboard basic auth (1Password: Homelab → docker.powder.agent)
#
# Plaintext, not the scrypt PASSWORD_HASH Hermes also accepts: Compose
# interpolates `$` in .env values and a scrypt hash is full of them.
# Keep the password free of `$` for the same reason.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=mez
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=xxxxx
# Stable token-signing key; without it sessions die on every restart.
HERMES_DASHBOARD_BASIC_AUTH_SECRET=xxxxx
