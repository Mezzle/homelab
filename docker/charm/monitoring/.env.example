# AdGuard Home Sync — primary instance (Raspberry Pi)
ADGUARD_PRIMARY_URL=http://192.168.1.x:3000
ADGUARD_PRIMARY_USER=admin
ADGUARD_PRIMARY_PASS=CHANGE_ME

# AdGuard Home Sync — replica (this instance)
ADGUARD_REPLICA_USER=admin
ADGUARD_REPLICA_PASS=CHANGE_ME

# Token for the shared dns.mez.run Cloudflare Tunnel. Store the real value in
# 1Password and sync it into this stack's untracked .env file.
CLOUDFLARE_DOH_TUNNEL_TOKEN=CHANGE_ME
